import json, os, re, sqlite3, threading, time, hashlib, hmac, secrets

DB   = os.path.join(os.path.dirname(os.path.abspath(__file__)), "alfred.db")
LOCK = threading.Lock()
ITERS = 120000
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
_rate, RLOCK = {}, threading.Lock()

def _conn():
    c = sqlite3.connect(DB, timeout=10)
    c.execute("""CREATE TABLE IF NOT EXISTS users(
      id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,
      email TEXT NOT NULL UNIQUE, pw_hash TEXT NOT NULL, salt TEXT NOT NULL,
      plan TEXT NOT NULL DEFAULT 'Free', created REAL NOT NULL)""")
    c.execute("""CREATE TABLE IF NOT EXISTS sessions(
      token_hash TEXT PRIMARY KEY, user_id INTEGER NOT NULL, expires REAL NOT NULL)""")
    return c

def _hash_pw(pw, salt):
    return hashlib.pbkdf2_hmac("sha256", pw.encode(), bytes.fromhex(salt), ITERS).hex()

def _json(h, code, obj, cookie=None):
    b = json.dumps(obj).encode()
    h.send_response(code)
    h.send_header("Content-Type", "application/json")
    h.send_header("Content-Length", str(len(b)))
    h.send_header("Cache-Control", "no-store")
    if cookie: h.send_header("Set-Cookie", cookie)
    h.end_headers()
    try: h.wfile.write(b)
    except Exception: pass

def _cookie(h):
    raw = h.headers.get("Cookie") or ""
    for part in raw.split(";"):
        if "=" in part:
            k, v = part.strip().split("=", 1)
            if k == "alfred_session": return v
    return None

def _user_from_session(h):
    tok = _cookie(h)
    if not tok: return None
    th = hashlib.sha256(tok.encode()).hexdigest()
    with LOCK:
        c = _conn()
        row = c.execute("""SELECT u.id,u.name,u.email,u.plan FROM sessions s
          JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires>?
          """, (th, time.time())).fetchone()
        c.close()
    return {"name": row[1], "email": row[2], "plan": row[3]} if row else None

def _rate_ok(ip):
    now = time.time()
    with RLOCK:
        q = [t for t in _rate.get(ip, []) if now - t < 600]
        if len(q) >= 20: _rate[ip] = q; return False
        q.append(now); _rate[ip] = q; return True

def maybe_handle(handler, method):
    try:
        path = (handler.path or "").split("?")[0]
        if not path.startswith("/api/auth/"): return False
        ip = handler.client_address[0] if handler.client_address else "?"

        if path == "/api/auth/me" and method == "GET":
            u = _user_from_session(handler)
            _json(handler, 200 if u else 401, {"ok": bool(u), "user": u} if u else {"ok": False, "error": "Not signed in"})
            return True

        body = {}
        if method == "POST":
            n = int(handler.headers.get("Content-Length") or 0)
            if n > 16384: _json(handler, 413, {"ok": False, "error": "Request too large"}); return True
            if n: 
                try: body = json.loads(handler.rfile.read(n).decode() or "{}")
                except Exception: body = {}
            if path == "/api/auth/logout":
                tok = _cookie(handler)
                if tok:
                    th = hashlib.sha256(tok.encode()).hexdigest()
                    with LOCK:
                        c = _conn(); c.execute("DELETE FROM sessions WHERE token_hash=?", (th,)); c.commit(); c.close()
                _json(handler, 200, {"ok": True}, "alfred_session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0")
                return True
            if path not in ("/api/auth/login", "/api/auth/register"):
                _json(handler, 404, {"ok": False, "error": "Unknown auth endpoint"}); return True
        else:
            _json(handler, 405, {"ok": False, "error": "Method not allowed"}); return True

        if not _rate_ok(ip):
            _json(handler, 429, {"ok": False, "error": "Too many attempts. Wait a few minutes."}); return True

        email = (body.get("email") or "").strip().lower()
        pw    = body.get("password") or ""
        name  = (body.get("name") or "").strip()
        if not EMAIL_RE.match(email): _json(handler, 400, {"ok": False, "error": "Enter a valid email address."}); return True
        if len(pw) < 8: _json(handler, 400, {"ok": False, "error": "Password must be at least 8 characters."}); return True

        register = path.endswith("/register")
        if register and not (2 <= len(name) <= 40):
            _json(handler, 400, {"ok": False, "error": "Enter your name."}); return True

        with LOCK:
            c = _conn()
            c.execute("DELETE FROM sessions WHERE expires < ?", (time.time(),))
            if register:
                salt = secrets.token_hex(16)
                try:
                    c.execute("INSERT INTO users(name,email,pw_hash,salt,plan,created) VALUES(?,?,?,?,?,?)",
                              (name, email, _hash_pw(pw, salt), salt, "Free", time.time()))
                    c.commit()
                except sqlite3.IntegrityError:
                    c.close(); _json(handler, 409, {"ok": False, "error": "An account with this email already exists. Try signing in."}); return True
            row = c.execute("SELECT id,name,pw_hash,salt,plan FROM users WHERE email=?", (email,)).fetchone()
            if register and row:
                uid, uname, plan = row[0], row[1], row[4]
            else:
                if row:
                    uid, uname, plan = row[0], row[1], row[4]
                    if not hmac.compare_digest(row[2], _hash_pw(pw, row[3])):
                        c.close(); _json(handler, 401, {"ok": False, "error": "Email or password is incorrect."}); return True
                else:
                    _hash_pw(pw, secrets.token_hex(16))  # timing equalizer
                    c.close(); _json(handler, 401, {"ok": False, "error": "Email or password is incorrect."}); return True
            tok = secrets.token_urlsafe(32)
            days = 90 if (body.get("remember") or register) else 1
            exp = time.time() + days * 86400
            c.execute("INSERT OR REPLACE INTO sessions(token_hash,user_id,expires) VALUES(?,?,?)",
                      (hashlib.sha256(tok.encode()).hexdigest(), uid, exp))
            c.commit(); c.close()
        cookie = "alfred_session=%s; Path=/; HttpOnly; SameSite=Lax; Max-Age=%d" % (tok, days * 86400)
        _json(handler, 200, {"ok": True, "user": {"name": uname, "email": email, "plan": plan}}, cookie)
        return True
    except Exception as e:
        try: print("[auth]", repr(e))
        except Exception: pass
        try: _json(handler, 500, {"ok": False, "error": "Auth system error"})
        except Exception: pass
        return True
