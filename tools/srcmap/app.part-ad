    if (!el || !el.getClientRects().length) return false;
    var s = getComputedStyle(el);
    return s.display !== "none" && s.visibility !== "hidden";
  }
  function loginRoute() {
    return /^#\/?login(?:[/?]|$)/i.test(location.hash || "");
  }
  function gateVisible() {
    return Array.prototype.some.call(
