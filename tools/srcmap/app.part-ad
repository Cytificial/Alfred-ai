    var plan="";try{plan=localStorage.getItem("alfred_plan")||"";}catch(e){}
    b.textContent="v170:"+(window.__v170?"LIVE":"DEAD")+" gate:"+(gate?(vis?"OPEN":"hidden"):"none")+" plan:"+plan.slice(0,40);
