          n.nodeValue = n.nodeValue.replace(v, plan); hits++;
        }
      }
    }
  }
  setInterval(function () {
    if (busy) return; busy = true;
    var t = ""; try { t = localStorage.getItem("alfred_token") || ""; } catch (e) {}
