    for (var i = 0; i < cands.length; i++) {
      var el = cands[i], r = el.getBoundingClientRect(), cs = getComputedStyle(el);
      if (r.width > 170 && r.width < innerWidth * 0.92 && r.height > 220 &&
          r.left > -10 && r.left < 60 &&                 /* truly on-screen, left edge */
