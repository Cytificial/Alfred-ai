/* ===== v129: M1 brain indicators ===== */
.v129-dots{display:inline-flex;align-items:center;gap:5px;min-height:18px;}
.v129-dots i{display:block;width:6px;height:6px;border-radius:50%;background:#7cc4ff;animation:v129pulse 1s infinite ease-in-out;}
.v129-dots i:nth-child(2){animation-delay:.15s}.v129-dots i:nth-child(3){animation-delay:.3s}
@keyframes v129pulse{0%,60%,100%{opacity:.35;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
.v129-toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);z-index:2147483647;
  padding:10px 17px;border-radius:999px;color:#dff1ff;background:rgba(8,18,40,.96);
  border:1px solid rgba(110,190,255,.42);box-shadow:0 8px 26px rgba(0,0,0,.4);font-size:13px;}

/* ===== v130: streaming stop button ===== */
.send.v130-stop{ position:relative; color:transparent !important; }
.send.v130-stop > *{ opacity:0 !important; }
.send.v130-stop::after{
  content:""; position:absolute; left:50%; top:50%;
  width:12px; height:12px; margin:-6px 0 0 -6px;
  border-radius:3px; background:#ff6b81;
  animation:v130pulse 1.1s ease-in-out infinite;
}
@keyframes v130pulse{ 0%,100%{ opacity:.9; transform:scale(1);} 50%{ opacity:.5; transform:scale(.8);} }
/* ===== v236: fit every screen ===== */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
img, svg, video, canvas { max-width: 100%; height: auto; }
.adm-t { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
button, .adm-btn, .set-row, .faq-q { max-width: 100%; overflow-wrap: anywhere; }
@media (max-width: 480px) {
  .adm-card, .set-card { padding: 12px !important; }
  h1, h2 { font-size: clamp(20px, 6vw, 28px) !important; }
  select, textarea, input { font-size: 16px !important; }
}
@media (min-width: 1024px) {
  .set-wrap { max-width: 860px; margin: 0 auto; }
}
/* ===== v240: admin dashboard fits every screen ===== */
#view-admin, section[id*="admin"] { overflow-y: auto !important; overflow-x: hidden !important; -webkit-overflow-scrolling: touch; }
#view-admin .adm-card { max-width: 100%; overflow-wrap: anywhere; }
#view-admin .adm-t { display: block; width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
#view-admin select, #view-admin input, #view-admin button { max-width: 100%; }
/* ===== v242: dashboard tabs + rows fit every screen ===== */
#view-admin button { white-space: nowrap; }
#view-admin [style*="display:flex"] { flex-wrap: wrap; row-gap: 6px; }
#adm-body { overflow-x: hidden; }
#adm-body .adm-card { max-width: 100%; }
/* v245.4: mark legibility on bright backdrops + sidebar polish */
img[src*="brand-192"], img[src*="brand-512"] {
  opacity: 1;
  filter: drop-shadow(0 0 10px rgba(6,12,22,.9)) drop-shadow(0 0 28px rgba(6,12,22,.7));
}
aside::-webkit-scrollbar, nav::-webkit-scrollbar { width: 0; height: 0; }
/* v245.6: brand mark carries its own ring - wrappers must not add a second one */
img[src*="brand-"] {
  border: 0 !important;
  box-shadow: none !important;
  outline: 0 !important;
  background: transparent !important;
}
/* v245.7: ring-less lambda fills its circle */
img[src*="lambda-192"] { width: 100%; height: 100%; object-fit: contain; display: block; }
/* v249: copy affordances */
#view-chat pre { position: relative; }
.v249cp { position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,.45); color: #cfe9ff;
  border: 1px solid rgba(159,216,255,.3); border-radius: 6px; padding: 2px 8px;
  font: 11px system-ui; cursor: pointer; z-index: 3; }
.v249row { position: relative; }
.v249row > .v249cp { top: -2px; right: 0; opacity: .55; }
.v249row:hover > .v249cp { opacity: 1; }
/* v251: transitions + admin fit */
.v251in { animation: v251in .34s ease both; }
@keyframes v251in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) { .v251in { animation: none; } }
#view-admin { overflow: auto; -webkit-overflow-scrolling: touch; max-width: 100%; }
.v251scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; }
.v251scroll .adm-t { min-width: 620px; }
/* v252: GPT-style chat - no avatars in the stream (header mark stays) */
#view-chat .msg-av, #view-chat [class*="msg-av"] { display: none !important; }
/* v253: readability + GPT-style chat */
aside, nav, [class*="sidebar"] { background-color: rgba(8,13,24,.93) !important; }
.v253-ai-b { background: rgba(255,255,255,.055) !important; border: 1px solid rgba(255,255,255,.12) !important; }
.v253-user-b { background: rgba(46,127,214,.30) !important; border: 1px solid rgba(120,180,255,.55) !important; }
/* v254: admin tabs scroll + explore placeholders */
.v254tabs { overflow-x: auto !important; flex-wrap: nowrap !important; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.v254tabs::-webkit-scrollbar { display: none; }
.v254tabs > * { flex: 0 0 auto; }
/* v256: exact-selective fixes (selectors from real markup) */
#new-chat .nc-ic { display: none !important; }            /* New Chat: icon AND empty shell gone */
#hero .hero-logo { display: none !important; }            /* chat welcome: big Lambda gone, chips stay */
.side-head .badge img { display: block !important; }      /* sidebar header mark - KEEP */
.model .m-av img, header .m-av img { display: block !important; } /* top bar mark - KEEP */
.nav .nav-item { display: flex !important; opacity: 1 !important; visibility: visible !important; }
/* v258: truth sweeps + scroll lanes */
.nc-ic { display: none !important; }
.side-head .nc-ic, .model .nc-ic, header .nc-ic { display: block !important; }
.nav-item { display: flex !important; opacity: 1 !important; visibility: visible !important; }
#v248b-strip { display: flex; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; }
#v248b-strip > * { flex: 0 0 auto; max-width: 72vw; }
#view-admin > * { max-width: 100%; }
