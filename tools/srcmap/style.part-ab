; color:#eaf6ff; background:rgba(60,150,255,.22); backdrop-filter:blur(8px);
  box-shadow:0 0 22px rgba(70,190,255,.25); }
.ex-hero-btn:active{ transform:scale(.96); }

.ex-grid > *{ transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease; will-change:transform; }
.ex-grid > *:hover{ border-color:rgba(110,215,255,.55) !important;
  box-shadow:0 14px 40px rgba(0,20,50,.55), 0 0 26px rgba(70,190,255,.22) !important; }
.ex-grid img{ transition:transform .5s ease; }
.ex-grid > *:hover img{ transform:scale(1.07); }
.pulse{ animation:likep .45s ease; }
@keyframes likep{ 40%{ transform:scale(1.3); } }

.ex-lb{ position:fixed; inset:0; z-index:90; display:flex; align-items:center; justify-content:center; padding:18px;
  background:rgba(2,8,22,.82); backdrop-filter:blur(14px); opacity:0; pointer-events:none; transition:opacity .3s; }
.ex-lb.on{ opacity:1; pointer-events:auto; }
.ex-lb-card{ position:relative; width:min(560px,94vw); max-height:92vh; overflow:auto; border-radius:22px;
  background:rgba(9,18,38,.92); border:1px solid rgba(100,190,255,.4); box-shadow:0 30px 90px rgba(0,10,30,.7);
  animation:lbin .35s ease; }
@keyframes lbin{ from{ transform:translateY(16px); opacity:0; } }
.ex-lb-img{ aspect-ratio:3/4; max-height:56vh; background-size:cover; background-position:center; }
.ex-lb-txt{ padding:16px 18px 18px; }
.ex-lb-txt p{ margin:0 0 14px; color:#bcd8f5; font-size:14px; line-height:1.5; }
.ex-lb-try{ cursor:pointer; border:1px solid rgba(120,220,255,.5); border-radius:999px; padding:11px 16px;
  font:600 13px/1 system-ui,sans-serif; color:#eaf6ff; background:rgba(60,150,255,.22); }
.ex-lb-x{ position:absolute; top:10px; right:10px; z-index:2; cursor:pointer; width:34px; height:34px; border-radius:50%;
  border:1px solid rgba(140,200,255,.4); background:rgba(5,12,28,.7); color:#dceaff; font-size:14px; }

/* ===== v77: shimmer + fade ===== */
.ex-grid img{
  opacity:0; transition:opacity .6s ease;
  background:linear-gradient(110deg, rgba(30,60,110,.3) 30%, rgba(80,160,255,.18) 50%, rgba(30,60,110,.3) 70%);
  background-size:220% 100%; animation:shim77 1.6s linear infinite;
}
@keyframes shim77{ to{ background-position:-120% 0; } }
.ex-hero-bg{
  background:linear-gradient(110deg, rgba(20,45,90,.5) 30%, rgba(90,170,255,.18) 50%, rgba(20,45,90,.5) 70%);
  background-size:220% 100%;
  animation:shim77 2s linear infinite, exhb 26s ease-in-out infinite alternate;
}

/* ===== v79: settings ===== */
.set-wrap{ padding:18px 16px 40px; display:flex; flex-direction:column; gap:14px; max-width:640px; margin:0 auto; }
.set-head h1{ margin:0; font-size:clamp(26px,6vw,36px); color:#fff; text-shadow:0 2px 18px rgba(80,180,255,.4); }
.set-head p{ margin:4px 0 0; color:#9db8d8; font-size:13.5px; }
.set-card{ background:rgba(10,20,42,.66); border:1px solid rgba(90,160,255,.28); border-radius:18px;
  padding:16px; backdrop-filter:blur(12px); box-shadow:0 10px 30px rgba(0,8,24,.35); }
.set-ct{ font:700 10.5px/1 system-ui,sans-serif; letter-spacing:.16em; color:#7fc4f5; margin-bottom:12px; }
.set-row{ display:flex; align-items:center; gap:12px; padding:9px 0; }
.set-row + .set-row{ border-top:1px solid rgba(90,160,255,.12); }
.set-av{ width:46px; height:46px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  font-size:20px; font-weight:700; color:#cfeaff; background:radial-gradient(circle at 35% 30%, rgba(90,170,255,.5), rgba(20,60,130,.6));
  border:1px solid rgba(120,200,255,.4); box-shadow:0 0 16px rgba(70,170,255,.3); flex:0 0 auto; }
.set-grow{ flex:1; min-width:0; }
.set-grow label{ display:block; font:600 11px/1 system-ui,sans-serif; color:#8fb4d8; margin-bottom:6px; }
.set-grow input{ width:100%; background:rgba(6,14,32,.8); border:1px solid rgba(90,160,255,.3); border-radius:12px;
  color:#eaf4ff; padding:11px 13px; font-size:14px; outline:none; }
.set-grow input:focus{ border-color:rgba(120,215,255,.65); box-shadow:0 0 14px rgba(70,190,255,.25); }
.set-b{ display:block; font-size:13.5px; color:#e6f1ff; }
.set-i{ display:block; font-size:11.5px; color:#8aa8c8; margin-top:2px; font-style:normal; }
.set-pills{ display:flex; flex-direction:column; gap:8px; }
.set-pill{ text-align:left; cursor:pointer; background:rgba(8,16,36,.7); border:1px solid rgba(90,160,255,.25);
  border-radius:14px; padding:12px 14px; color:#cfe2f8; }
.set-pill b{ display:block; font-size:14px; }
.set-pill i{ font-style:normal; font-size:11.5px; color:#89a9cc; }
.set-pill.on{ border-color:rgba(120,215,255,.65); box-shadow:0 0 18px rgba(70,190,255,.28);
  background:linear-gradient(160deg, rgba(30,90,160,.35), rgba(10,30,70,.6)); }
.set-swatches{ display:flex; gap:10px; flex-wrap:wrap; }
.set-sw{ cursor:pointer; display:flex; align-items:center; gap:8px; border-radius:999px; padding:9px 14px 9px 10px;
  background:rgba(8,16,36,.7); border:1px solid rgba(90,160,255,.25); color:#cfe2f8; font-size:12.5px; }
.set-sw::before{ content:""; width:18px; height:18px; border-radius:50%; background:var(--sw,#5ad1ff);
  box-shadow:0 0 10px var(--sw,#5ad1ff); }
.set-sw.on{ border-color:var(--sw,#5ad1ff); box-shadow:0 0 16px color-mix(in srgb, var(--sw) 45%, transparent); }
.set-tgl{ position:relative; width:52px; height:29px; border-radius:999px; border:1px solid rgba(90,160,255,.35);
  background:rgba(8,16,36,.8); cursor:pointer; transition:.25s; flex:0 0 auto; }
.set-tgl::after{ content:""; position:absolute; top:3px; left:3px; width:21px; height:21px; border-radius:50%;
  background:#7f9cc0; transition:.25s; }
.set-tgl.on{ background:linear-gradient(90deg, rgba(50,140,240,.55), rgba(90,200,255,.55)); border-color:rgba(140,220,255,.7); }
.set-tgl.on::after{ left:26px; background:#fff; box-shadow:0 0 12px rgba(160,230,255,.9); }
.set-danger{ border-color:rgba(255,110,110,.3); }
.set-btn{ cursor:pointer; border-radius:12px; border:1px solid rgba(90,160,255,.3); background:rgba(30,70,140,.25);
  color:#dbe9fb; padding:11px 14px; font:600 13px/1 system-ui,sans-serif; margin:4px 6px 4px 0; }
.set-btn.warn{ border-color:rgba(255,190,90,.4); color:#ffd9a8; background:rgba(160,100,20,.18); }
.set-btn.red{ border-color:rgba(255,110,110,.45); color:#ffc2c2; background:rgba(200,50,50,.2); }
.set-btn:active{ transform:scale(.97); }
.set-health{ display:flex; align-items:center; gap:9px; font-size:13px; color:#c9def5; }
.hp-dot{ width:10px; height:10px; border-radius:50%; background:#7f9cc0; }
.hp-dot.ok{ background:#4ade80; box-shadow:0 0 10px rgba(74,222,128,.8); }
.hp-dot.bad{ background:#f87171; box-shadow:0 0 10px rgba(248,113,113,.8); }
.set-ver{ margin-top:12px; font-size:11px; color:#6f8bab; }
.set-modal{ position:fixed; inset:0; z-index:95; display:flex; align-items:center; justify-content:center;
  background:rgba(2,8,22,.75); backdrop-filter:blur(10px); opacity:0; transition:.25s; }
.set-modal.on{ opacity:1; }
.set-mc{ width:min(360px,88vw); background:rgba(12,22,46,.95); border:1px solid rgba(255,120,120,.35);
  border-radius:18px; padding:20px; animation:lbin .3s ease; }
.set-mc p{ margin:0 0 16px; color:#eaf2ff; font-size:14.5px; line-height:1.5; }

/* accent themes: repaint the app's key glows */
html[data-accent="violet"]{ --acc:177,140,255; }
html[data-accent="amber"]{ --acc:255,180,107; }
html[data-accent="emerald"]{ --acc:95,232,176; }
html[data-accent="cyan"], html:not([data-accent]){ --acc:90,209,255; }
.composer:focus-within{ border-color:rgba(var(--acc),.6) !important;
  box-shadow:0 0 0 1.5px rgba(var(--acc),.4), 0 0 26px rgba(var(--acc),.35) !important; }
.fx-send{ box-shadow:0 0 0 2px rgba(var(--acc),.4), 0 0 26px rgba(var(--acc),.6) !important; }
.ex-hero-btn, .ex-lb-try{ border-color:rgba(var(--acc),.55) !important; box-shadow:0 0 18px rgba(var(--acc),.28) !important; }

/* ===== v80: settings sections ===== */
.faq-list{ display:flex; flex-direction:column; }
.faq-i{ border-bottom:1px solid rgba(90,160,255,.12); }
.faq-i:last-child{ border-bottom:0; }
.faq-q{ width:100%; display:flex; justify-content:space-between; align-items:center; gap:10px;
  background:none; border:0; color:#e6f1ff; font:600 13.5px/1.3 system-ui,sans-serif;
  padding:13px 2px; cursor:pointer; text-align:left; }
.faq-q span{ color:#7fc4f5; font-size:17px; transition:transform .25s; }
.faq-i.open .faq-q span{ transform:rotate(45deg); }
.faq-a{ max-height:0; overflow:hidden; transition:max-height .3s ease; color:#9db8d8; font-size:12.5px; line-height:1.55; }
.faq-i.open .faq-a{ max-height:120px; padding:0 2px 13px; }
.set-link{ width:100%; background:none; border:0; border-radius:12px; cursor:pointer; text-align:left; }
.set-link:active{ background:rgba(60,140,240,.12); }
.stor-bar{ display:block; margin-top:7px; height:7px; border-radius:99px; background:rgba(8,16,36,.9);
  border:1px solid rgba(90,160,255,.25); overflow:hidden; }
.stor-bar span{ display:block; height:100%; width:0; border-radius:99px;
  background:linear-gradient(90deg,#3f8cff,#7fd4ff); box-shadow:0 0 10px rgba(90,190,255,.6); transition:width .6s; }
html.rm *{ animation-duration:.001s !important; transition-duration:.001s !important; }

/* ===== v82: explore reborn ===== */
.ex-hero-bg{ background-size:cover !important; background-position:center !important; }

#view-explore{ position:relative; }
#view-explore::before{ content:""; position:absolute; inset:-10% 0 auto 0; height:130%; z-index:0; pointer-events:none;
  background:
    radial-gradient(1.5px 1.5px at 12% 18%, rgba(255,255,255,.9), transparent 60%),
    radial-gradient(1px 1px at 78% 12%, rgba(190,230,255,.8), transparent 60%),
    radial-gradient(2px 2px at 55% 32%, rgba(255,255,255,.7), transparent 60%),
    radial-gradient(1px 1px at 33% 44%, rgba(170,220,255,.75), transparent 60%),
    radial-gradient(1.5px 1.5px at 88% 52%, rgba(255,255,255,.6), transparent 60%),
    radial-gradient(circle at 85% 8%, rgba(90,60,180,.18), transparent 42%),
    radial-gradient(circle at 8% 30%, rgba(20,120,190,.16), transparent 45%),
    url('../assets/gen/explore-sky.jpg');
  background-size:100% 100%,100% 100%,100% 100%,100% 100%,100% 100%,auto,auto,cover;
  opacity:.5; animation:twk 7s ease-in-out infinite alternate; }
@keyframes twk{ from{ opacity:.38; } to{ opacity:.6; } }
.explore-wrap{ position:relative; z-index:1; }

.ex-grid > *{ animation:cardin .55s ease both; }
.ex-grid > *:nth-child(2){ animation-delay:.07s; } .ex-grid > *:nth-child(3){ animation-delay:.14s; }
.ex-grid > *:nth-child(4){ animation-delay:.21s; } .ex-grid > *:nth-child(5){ animation-delay:.28s; }
.ex-grid > *:nth-child(6){ animation-delay:.35s; } .ex-grid > *:nth-child(7){ animation-delay:.42s; }
.ex-grid > *:nth-child(8){ animation-delay:.49s; }
@keyframes cardin{ from{ opacity:0; transform:translateY(16px); } }

/* ===== v83: scroll law + fit-all-screens pass ===== */

/* --- scroll: nothing above the content may eat touches --- */
#view-explore{ position:relative !important; overflow-y:auto !important;
  -webkit-overflow-scrolling:touch; overscroll-behavior:contain; touch-action:pan-y; }
#view-explore::before{ pointer-events:none !important; position:fixed !important;
  inset:0 !important; height:100% !important; }          /* sky stays put, can't extend/capture */
.ex-lb, .set-modal{ pointer-events:none; }
.ex-lb.on, .set-modal.on{ pointer-events:auto; }
.explore-wrap, .ex-grid, .ex-grid > *, .ex-hero{ touch-action:pan-y; }
#view-history .const-stage, #view-settings{ touch-action:pan-y; }

/* --- explore: fluid on every screen --- */
.ex-hero{ min-height:clamp(200px, 30vh, 320px); }
.ex-hero-in{ padding:clamp(16px, 4vw, 26px); }
.ex-hero h1{ font-size:clamp(28px, 7.5vw, 46px); }
.ex-hero p{ font-size:clamp(13px, 3.4vw, 15px); max-width:min(46ch, 92%); }
.explore-wrap{ padding-inline:clamp(10px, 3vw, 28px); }
.ex-grid{ display:grid !important; grid-template-columns:repeat(auto-fill, minmax(clamp(140px, 42vw, 230px), 1fr)) !important;
  gap:clamp(10px, 2.6vw, 18px) !important; }
.ex-grid img, .ex-grid [style*="background-image"]{ min-height:clamp(120px, 24vw, 200px); }
.ex-f{ padding:9px 14px; font-size:clamp(12px, 3.2vw, 13.5px); }

/* --- settings: fluid + comfortable thumbs --- */
.set-wrap{ padding:clamp(14px, 4vw, 32px) clamp(12px, 3vw, 24px) 44px; }
.set-card{ padding:clamp(13px, 3.4vw, 20px); border-radius:clamp(15px, 4vw, 20px); }
.set-head h1{ font-size:clamp(24px, 6.4vw, 38px); }
.set-btn{ min-height:44px; }                              /* tap-target law */
.set-tgl{ width:52px; height:31px; }

/* --- low-end phones: calm the heavy layers --- */
@media (max-width:700px){
  #view-explore::before{ animation:none !important; opacity:.45; }
  .ex-hero-bg{ animation:exhb 26s ease-in-out infinite alternate !important; }
  .ex-grid > *{ animation-duration:.4s; }
}

/* --- big screens: breathe more --- */
@media (min-width:1100px){
  .explore-wrap{ max-width:1180px; margin:0 auto; }
  .set-wrap{ max-width:720px; }
  .ex-hero{ min-height:340px; }
}

/* ===== v87: plans ===== */
.pay-wrap{ padding:clamp(16px,4vw,34px) clamp(14px,3.5vw,28px) 46px; max-width:1080px; margin:0 auto; }
.pay-hero{ text-align:center; padding:clamp(8px,2vw,18px) 0 6px; }
.pay-kick{ font:700 11px/1 system-ui,sans-serif; letter-spacing:.22em; color:#8fd6ff; }
.pay-hero h1{ margin:10px 0 8px; font-size:clamp(30px,7.5vw,50px); color:#fff;
  text-shadow:0 2px 26px rgba(80,180,255,.55); }
.pay-hero p{ margin:0 auto; color:#a9c4e4; font-size:clamp(13px,3.4vw,15px); max-width:52ch; }
.pay-toggle{ display:inline-flex; gap:6px; margin-top:16px; padding:5px; border-radius:999px;
  background:rgba(8,16,36,.8); border:1px solid rgba(90,160,255,.3); }
.pay-toggle button{ border:0; cursor:pointer; border-radius:999px; padding:9px 16px; color:#bcd4ee;
  background:transparent; font:600 12.5px/1 system-ui,sans-serif; }
.pay-toggle button.on{ background:linear-gradient(120deg,rgba(60,150,255,.5),rgba(120,210,255,.45)); color:#fff;
  box-shadow:0 0 16px rgba(80,190,255,.4); }
.pay-toggle i{ display:block; font-style:normal; font-size:9.5px; color:#9fe8b8; margin-top:2px; }
.pay-cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(clamp(220px,44vw,280px),1fr));
  gap:clamp(12px,2.6vw,20px); margin-top:22px; }
.pay-card{ position:relative; background:rgba(10,20,42,.72); border:1px solid rgba(90,160,255,.28);
  border-radius:20px; padding:clamp(16px,3.6vw,24px); backdrop-filter:blur(12px);
  box-shadow:0 14px 40px rgba(0,10,30,.4); transition:transform .25s, border-color .25s, box-shadow .25s; }
.pay-card:hover{ transform:translateY(-4px); border-color:rgba(110,210,255,.55);
  box-shadow:0 20px 50px rgba(0,16,40,.55), 0 0 26px rgba(70,190,255,.2); }
.pay-card.pop{ border-color:rgba(130,215,255,.6);
  background:linear-gradient(165deg, rgba(30,90,170,.4), rgba(10,26,60,.75)); }
.pay-card.mine{ border-color:rgba(120,255,200,.55); box-shadow:0 0 22px rgba(90,230,180,.22); }
.pay-rib{ position:absolute; top:-11px; left:50%; transform:translateX(-50%);
  font:700 9.5px/1 system-ui,sans-serif; letter-spacing:.14em; color:#04122a;
  background:linear-gradient(90deg,#7fd4ff,#b8a8ff); padding:6px 12px; border-radius:999px; white-space:nowrap; }
.pay-card h3{ margin:0; font-size:clamp(19px,4.6vw,24px); color:#fff; }
.pay-tag{ font-style:normal; color:#8fb0d4; font-size:12px; }
.pay-price{ margin:14px 0 6px; display:flex; align-items:baseline; gap:6px; }
.pay-price .pv{ font-size:clamp(30px,7vw,40px); color:#fff; text-shadow:0 0 18px rgba(120,210,255,.5); }
.pay-price .pu{ color:#7f9cc0; font-size:12.5px; }
.pay-feats{ list-style:none; margin:10px 0 16px; padding:0; }
.pay-feats li{ color:#cfe2f8; font-size:13px; padding:6px 0; border-bottom:1px dashed rgba(90,160,255,.14); }
.pay-feats li:last-child{ border-bottom:0; }
.pay-cta{ width:100%; cursor:pointer; border-radius:14px; border:1px solid rgba(120,210,255,.5);
  background:rgba(50,130,240,.28); color:#eaf6ff; padding:13px; font:600 13.5px/1 system-ui,sans-serif;
  box-shadow:0 0 18px rgba(70,180,255,.22); }
.pay-cta:active{ transform:scale(.97); }
.pay-card.pop .pay-cta{ background:linear-gradient(120deg,rgba(70,170,255,.65),rgba(150,220,255,.55));
  border-color:rgba(170,235,255,.8); }
.pay-trust{ margin-top:18px; text-align:center; color:#6f8bab; font-size:11.5px; }
.pay-nav-ic{ display:inline-flex; }
.pay-modal{ position:fixed; inset:0; z-index:95; display:flex; align-items:center; justify-content:center;
  background:rgba(2,8,22,.78); backdrop-filter:blur(12px); opacity:0; pointer-events:none; transition:.25s; }
.pay-modal.on{ opacity:1; pointer-events:auto; }
.pay-mc{ width:min(380px,90vw); background:rgba(12,22,46,.96); border:1px solid rgba(110,200,255,.4);
  border-radius:20px; padding:22px; animation:lbin .3s ease; position:relative; }
.pay-mc h3{ margin:0 0 8px; color:#fff; font-size:19px; }
.pay-mc p{ margin:0 0 14px; color:#a9c4e4; font-size:13px; line-height:1.55; }
.pay-mc input{ width:100%; background:rgba(6,14,32,.85); border:1px solid rgba(90,160,255,.35);
  border-radius:12px; color:#eaf4ff; padding:12px 13px; font-size:14px; outline:none; margin-bottom:12px; }
.pay-mc input:focus{ border-color:rgba(130,220,255,.7); box-shadow:0 0 14px rgba(70,190,255,.3); }
.pay-mrow{ display:flex; gap:8px; flex-wrap:wrap; }
.pay-btn{ cursor:pointer; border-radius:12px; padding:12px 14px; font:600 13px/1 system-ui,sans-serif;
  border:1px solid rgba(90,160,255,.35); background:rgba(30,70,140,.25); color:#dbe9fb; flex:1; }
.pay-btn.pri{ background:linear-gradient(120deg,rgba(60,150,255,.6),rgba(140,220,255,.5));
  border-color:rgba(170,235,255,.75); color:#fff; box-shadow:0 0 18px rgba(80,190,255,.35); }
.pay-mx{ position:absolute; top:10px; right:10px; width:32px; height:32px; border-radius:50%;
  border:1px solid rgba(140,200,255,.4); background:rgba(5,12,28,.7); color:#dceaff; cursor:pointer; }

/* ===== v88: flow history + plans cinema ===== */
#view-history{ touch-action:pan-y; }
.flow88 .const-stage{ background:#02060f !important; }
.flow88 .orbit-svg2, .flow88 .orbit-svg{ display:none !important; }
.cosmos-fixed{ position:fixed; inset:0; z-index:0; pointer-events:none;
  background-size:cover; background-position:center; opacity:.9;
  animation:wkb 40s ease-in-out infinite alternate; }
.cosmos-fixed::after{ content:""; position:absolute; inset:0;
  background:linear-gradient(180deg, rgba(2,8,20,.55), rgba(2,8,20,.12) 40%, rgba(2,8,20,.82)); }
#const-nodes{ z-index:2; }
.world-bg.on{ opacity:.45; }

#view-pay{ position:relative; }
#view-pay::before{ content:""; position:absolute; inset:0; z-index:0; pointer-events:none;
  background:
    radial-gradient(1.5px 1.5px at 14% 16%, rgba(255,255,255,.9), transparent 60%),
    radial-gradient(1px 1px at 76% 10%, rgba(190,230,255,.8), transparent 60%),
    radial-gradient(2px 2px at 58% 30%, rgba(255,255,255,.7), transparent 60%),
    radial-gradient(circle at 85% 6%, rgba(120,70,220,.2), transparent 45%),
    radial-gradient(circle at 10% 28%, rgba(20,120,190,.18), transparent 45%),
    url('../assets/gen/explore-sky.jpg');
  background-size:100% 100%,100% 100%,100% 100%,auto,auto,cover;
  opacity:.55; animation:twk 8s ease-in-out infinite alternate; }
.pay-wrap{ position:relative; z-index:1; }
.pay-hero{ position:relative; }
.pay-hero::before{ content:""; position:absolute; left:50%; top:-30px; width:min(420px,80vw); aspect-ratio:1;
  transform:translateX(-50%); border-radius:50%; pointer-events:none;
  background:radial-gradient(circle, rgba(90,180,255,.28), rgba(60,120,255,.1) 45%, transparent 70%); filter:blur(6px); }
.pay-card{ animation:cardin .55s ease both; }
.pay-card:nth-child(2){ animation-delay:.08s; } .pay-card:nth-child(3){ animation-delay:.16s; }
.pay-cta{ transition:transform .22s, box-shadow .22s; letter-spacing:.02em; }
.pay-cta:hover{ transform:translateY(-2px); box-shadow:0 10px 34px rgba(80,180,255,.5); }
.pay-card.pop{ transform:scale(1.02); }
.pay-card.pop .pay-cta{ background:linear-gradient(120deg,#3f8cff,#8fd6ff 60%,#b8a8ff);
  color:#04122a; font-weight:800; border-color:transparent; box-shadow:0 10px 34px rgba(90,180,255,.5); }
.pay-price .pv{ animation:pvglow 3.2s ease-in-out infinite; }
@keyframes pvglow{ 0%,100%{ text-shadow:0 0 16px rgba(120,210,255,.45); } 50%{ text-shadow:0 0 30px rgba(160,230,255,.85); } }
@media (max-width:760px){ .pay-cards{ display:flex; flex-direction:column; } .pay-card.pop{ order:-1; } }
@media (prefers-reduced-motion:reduce){ #view-pay::before,.pay-price .pv,.cosmos-fixed{ animation:none; } }

/* ===== v89: chat-box list over the fixed cosmos ===== */
.list89 .const-stage{ display:none !important; }
.gal-list{ position:relative; z-index:2; max-width:640px; margin:10px auto 44px;
  padding:0 14px; display:flex; flex-direction:column; gap:12px; }
.gal-row{ display:flex; align-items:center; gap:14px; padding:12px 14px; border-radius:18px;
  background:rgba(9,18,38,.72); border:1px solid rgba(90,160,255,.28); backdrop-filter:blur(10px);
  cursor:pointer; animation:cardin .4s ease both; transition:border-color .2s, box-shadow .2s; }
.gal-row:active{ transform:scale(.985); }
.gal-row.on{ border-color:rgba(130,220,255,.65); box-shadow:0 0 18px rgba(80,190,255,.3); }
.gal-orb{ width:54px; height:54px; border-radius:50%; flex:0 0 auto; background-size:cover; background-position:center;
  box-shadow:0 0 16px rgba(120,190,255,.35), inset 0 0 12px rgba(2,8,24,.5); }
.gal-meta{ flex:1; min-width:0; }
.gal-meta b{ display:block; color:#eaf4ff; font-size:15px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.gal-meta i{ font-style:normal; color:#8aa8c8; font-size:12px; }
.gal-acts{ display:flex; align-items:center; gap:10px; flex:0 0 auto; }
.g-del{ width:38px; height:38px; border-radius:12px; border:1px solid rgba(255,110,110,.35);
  background:rgba(200,60,60,.18); color:#ffc9c9; cursor:pointer; font-size:15px; }
.g-open{ color:#9fd2ff; font:600 12.5px/1 system-ui,sans-serif; }
@media (max-width:380px){ .gal-orb{ width:46px; height:46px; } .g-open{ display:none; } }

/* ===== v90: history = list only, solid rows ===== */
.list89 > *:not(.gal-list):not(.cosmos-fixed){ display:none !important; }
.gal-row{ background:rgba(9,18,38,.9) !important; }
.gal-list{ padding-bottom:90px; }

/* ===== v94: history polish ===== */
.gal-head{ margin:16px 6px 2px; font-size:clamp(21px,5.6vw,30px); font-weight:800; color:#eaf4ff; text-shadow:0 2px 22px rgba(60,140,255,.35); }
.gal-head small{ display:block; font-size:12.5px; font-weight:500; color:rgba(180,205,255,.65); margin-top:3px; }
.gal-sec{ display:flex; align-items:center; gap:10px; margin:24px 4px 10px; }
.gal-sec b{ font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#9fc6ff; text-shadow:0 0 12px rgba(80,150,255,.5); white-space:nowrap; }
.gal-sec::after{ content:""; flex:1; height:1px; background:linear-gradient(90deg,rgba(120,180,255,.35),rgba(120,180,255,0)); }
.gal-list .gal-row{ animation:galIn .45s cubic-bezier(.2,.7,.2,1) both; animation-delay:calc(var(--gi,0)*45ms); }
@keyframes galIn{ from{ opacity:0; transform:translateY(14px) scale(.97); } to{ opacity:1; transform:none; } }
.row-gem svg{ filter:drop-shadow(0 0 6px rgba(110,220,255,.8)); }
.row-gem svg path{ stroke:#8fe3ff; }
.ic-gem{ color:#8fe3ff; text-shadow:0 0 10px rgba(110,220,255,.9); font-style:normal; }
@media (prefers-reduced-motion:reduce){ .gal-list .gal-row{ animation:none; } }
@media (max-width:380px){ .gal-sec b{ font-size:11px; } }
@media (min-width:1100px){ .gal-list{ max-width:760px; margin:0 auto; } }

/* ===== v95: history redesign — dim cosmos, clean list ===== */
#view-history{ background:#05070f !important; }
.cosmos-fixed{ position:fixed; inset:0; z-index:0; pointer-events:none; }
.cosmos-fixed::after{ content:""; position:absolute; inset:0;
  background:linear-gradient(180deg,rgba(4,6,14,.74),rgba(4,6,14,.92)); }
.gal-list{ position:relative; z-index:2; max-width:640px; margin:0 auto; padding-bottom:48px; }
.gal-list .gal-row{ margin:10px 0; padding:10px 14px; min-height:64px;
  background:rgba(10,16,30,.78); border:1px solid rgba(120,160,220,.14);
  border-radius:18px; backdrop-filter:blur(14px); }
.gal-list .gal-row:hover{ border-color:rgba(130,190,255,.4); }
.gal-list .gal-orb{ width:46px !important; height:46px !important; flex:0 0 46px; }
.gal-list .gal-row b{ font-size:15.5px; }
.gal-list .gal-row i{ font-size:12.5px; }
.gal-list .g-del{ background:transparent !important; border:none !important;
  box-shadow:none !important; width:38px; height:38px; opacity:.55; }
.gal-list .g-del:active{ opacity:1; transform:scale(.92); }

/* ===== v95: history redesign — dim cosmos, clean list ===== */
#view-history{ background:#05070f !important; }
.cosmos-fixed{ position:fixed; inset:0; z-index:0; pointer-events:none; }
.cosmos-fixed::after{ content:""; position:absolute; inset:0;
  background:linear-gradient(180deg,rgba(4,6,14,.74),rgba(4,6,14,.92)); }
.gal-list{ position:relative; z-index:2; max-width:640px; margin:0 auto; padding-bottom:48px; }
.gal-list .gal-row{ margin:10px 0; padding:10px 14px; min-height:64px;
  background:rgba(10,16,30,.78); border:1px solid rgba(120,160,220,.14);
  border-radius:18px; backdrop-filter:blur(14px); }
.gal-list .gal-row:hover{ border-color:rgba(130,190,255,.4); }
.gal-list .gal-orb{ width:46px !important; height:46px !important; flex:0 0 46px; }
.gal-list .gal-row b{ font-size:15.5px; }
.gal-list .gal-row i{ font-size:12.5px; }
.gal-list .g-del{ background:transparent !important; border:none !important;
  box-shadow:none !important; width:38px; height:38px; opacity:.55; }
.gal-list .g-del:active{ opacity:1; transform:scale(.92); }

/* ===== v96: package level panel ===== */
.pkg96{ margin:12px 0 6px; display:grid; gap:10px; animation:pkgIn .3s ease both; }
.pkg96[hidden]{ display:none; }
@keyframes pkgIn{ from{ opacity:0; transform:translateY(-8px); } to{ opacity:1; transform:none; } }
.pkg96-t{ font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#8fd0ff; text-shadow:0 0 12px rgba(80,150,255,.4); }
.pkg96-row{ text-align:left; padding:12px 14px; border-radius:16px; cursor:pointer;
  border:1px solid rgba(120,160,220,.18); background:rgba(10,16,30,.74); color:#eaf2ff;
  backdrop-filter:blur(12px); transition:border-color .2s, box-shadow .2s; }
.pkg96-row:active{ transform:scale(.985); }
.pkg96-row.on{ border-color:rgba(120,210,255,.7); box-shadow:0 0 20px rgba(80,170,255,.2); }
.pkg96-row b{ font-size:15.5px; }
.pkg96-row.on b::after{ content:" \u2713"; color:#8fe3ff; font-size:13px; }
.pkg96-row i{ display:block; font-style:normal; font-size:12px; color:rgba(170,200,255,.78); margin-top:2px; }
.pkg96-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }
.pkg96-chips span{ font-size:11.5px; padding:4px 10px; border-radius:999px;
  background:rgba(70,130,220,.16); border:1px solid rgba(110,170,255,.25); color:#cfe4ff; }
.pkg96-row.on .pkg96-chips span{ background:rgba(90,180,255,.24); }

/* ===== v97: level panel + plans glow ===== */
.pkg97{ margin:10px 0 4px; display:grid; gap:10px; animation:pkgIn97 .28s ease both; }
.pkg97[hidden]{ display:none; }
@keyframes pkgIn97{ from{ opacity:0; transform:translateY(-8px); } to{ opacity:1; transform:none; } }
.pkg97-t{ font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#8fd0ff; text-shadow:0 0 12px rgba(80,150,255,.4); }
.pkg97-row{ text-align:left; padding:12px 14px; border-radius:16px; cursor:pointer; width:100%;
  border:1px solid rgba(120,160,220,.18); background:rgba(10,16,30,.8); color:#eaf2ff;
  backdrop-filter:blur(12px); transition:border-color .2s, box-shadow .2s; }
.pkg97-row:active{ transform:scale(.985); }
.pkg97-row.on{ border-color:rgba(120,210,255,.7); box-shadow:0 0 20px rgba(80,170,255,.22); }
.pkg97-row b{ font-size:15.5px; }
.pkg97-row.on b::after{ content:" \2713"; color:#8fe3ff; font-size:13px; }
.pkg97-row i{ display:block; font-style:normal; font-size:12px; color:rgba(170,200,255,.78); margin-top:2px; }
.pkg97-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }
.pkg97-chips span{ font-size:11.5px; padding:4px 10px; border-radius:999px;
  background:rgba(70,130,220,.16); border:1px solid rgba(110,170,255,.25); color:#cfe4ff; }
.pkg97-row.on .pkg97-chips span{ background:rgba(90,180,255,.24); }
.w97-on{ border-radius:16px; box-shadow:inset 0 0 0 1px rgba(120,210,255,.4), 0 0 24px rgba(80,170,255,.22) !important; }
.w97-on svg{ filter:drop-shadow(0 0 8px rgba(120,220,255,.9)); }

/* ===== v99: module locks + detail sheet ===== */
.view-modules .m99-off{ filter:grayscale(.55) brightness(.72); }
.m99-lock{ position:absolute; top:10px; right:10px; z-index:3; }
.m99-lock span{ font-size:11px; font-weight:700; padding:5px 10px; border-radius:999px;
  background:rgba(8,12,24,.82); border:1px solid rgba(150,190,255,.35); color:#ffd98a;
  backdrop-filter:blur(8px); box-shadow:0 2px 10px rgba(0,0,0,.4); }
.m99-sheet{ position:fixed; inset:0; z-index:9990; }
.m99-sheet[hidden]{ display:none; }
.m99-back{ position:absolute; inset:0; background:rgba(3,6,14,.72); backdrop-filter:blur(6px); }
.m99-card{ position:absolute; left:50%; bottom:0; transform:translateX(-50%);
  width:min(440px,100%); max-height:86vh; overflow-y:auto; -webkit-overflow-scrolling:touch;
  background:linear-gradient(180deg,rgba(14,20,38,.97),rgba(8,12,26,.97));
  border:1px solid rgba(130,180,255,.22); border-bottom:none;
  border-radius:24px 24px 0 0; padding:22px 22px 26px; color:#eaf2ff;
  animation:m99up .32s cubic-bezier(.2,.8,.2,1) both; }
@keyframes m99up{ from{ transform:translate(-50%,40px); opacity:0; } to{ transform:translate(-50%,0); opacity:1; } }
.m99-big{ display:block; width:64px; height:64px; margin-bottom:12px; }
.m99-big svg{ width:64px; height:64px; filter:drop-shadow(0 6px 18px rgba(60,140,255,.45)); }
.m99-card h3{ font-size:23px; margin:0; }
.m99-card > i{ display:block; font-style:normal; font-size:13px; color:#8fd0ff; margin-top:3px; }
.m99-card p{ font-size:14px; line-height:1.55; color:rgba(210,225,255,.85); margin:12px 0 4px; }
.m99-sec{ font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:#8fd0ff; margin:16px 0 8px; }
.m99-mrow{ display:flex; align-items:center; gap:12px; padding:9px 10px; border-radius:14px;
  background:rgba(70,130,220,.10); border:1px solid rgba(110,170,255,.16); margin-bottom:8px; }
.m99-mrow.lk{ opacity:.6; }
.m99-lgo{ width:30px; height:30px; flex:0 0 30px; }
.m99-lgo svg{ width:30px; height:30px; border-radius:8px; }
.m99-mrow b{ font-size:14px; display:block; }
.m99-mrow i{ font-style:normal; font-size:11.5px; color:rgba(170,200,255,.7); }
.m99-mrow em{ margin-left:auto; font-style:normal; font-size:14px; color:#8fe3ff; }
.m99-cta{ width:100%; margin-top:12px; padding:13px; border:none; border-radius:14px; cursor:pointer;
  font-weight:800; font-size:14.5px; color:#04101f;
  background:linear-gradient(135deg,#7fd7ff,#4f9dff); box-shadow:0 8px 24px rgba(80,170,255,.35); }
.m99-x{ width:100%; margin-top:8px; padding:12px; border-radius:14px; cursor:pointer;
  background:transparent; border:1px solid rgba(130,180,255,.25); color:rgba(210,225,255,.8); font-size:13.5px; }
@media (min-width:700px){
  .m99-card{ bottom:auto; top:50%; transform:translate(-50%,-50%); border-radius:24px;
    border-bottom:1px solid rgba(130,180,255,.22); animation:m99pop .28s ease both; }
  @keyframes m99pop{ from{ transform:translate(-50%,-46%); opacity:0; } to{ transform:translate(-50%,-50%); opacity:1; } }
}

/* ===== v100: power levels panel ===== */
.pkg100{ flex:1 1 100%; width:100%; margin:12px 0 4px; display:grid; gap:12px; animation:pkgIn100 .3s ease both; }
.pkg100[hidden]{ display:none; }
@keyframes pkgIn100{ from{ opacity:0; transform:translateY(-8px); } to{ opacity:1; transform:none; } }
.pkg100-t{ font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#8fd0ff; text-shadow:0 0 12px rgba(80,150,255,.4); }
.pkg100-row{ display:flex; gap:13px; align-items:flex-start; width:100%; text-align:left; padding:14px 16px;
  border-radius:18px; cursor:pointer; border:1px solid rgba(120,160,220,.18);
  background:rgba(10,16,30,.8); color:#eaf2ff; backdrop-filter:blur(12px); transition:.2s; }
.pkg100-row:active{ transform:scale(.985); }
.pkg100-row.on{ border-color:rgba(120,210,255,.65); box-shadow:0 0 22px rgba(80,170,255,.22); }
.pkg100-mg{ width:42px; height:42px; border-radius:50%; flex:0 0 42px; display:flex; align-items:center;
  justify-content:center; font-weight:800; font-size:17px; color:#04101f; box-shadow:0 4px 14px rgba(0,0,0,.35); }
.pkg100-row[data-k="Free"] .pkg100-mg{ background:linear-gradient(135deg,#9fb4d8,#6c86b8); }
.pkg100-row[data-k="Pro"]  .pkg100-mg{ background:linear-gradient(135deg,#7fd7ff,#4f9dff); }
.pkg100-row[data-k="Ultra"] .pkg100-mg{ background:linear-gradient(135deg,#ffd98a,#ff9d5c); }
.pkg100-bd{ flex:1; min-width:0; }
.pkg100-nm{ display:flex; align-items:center; gap:8px; }
.pkg100-nm b{ font-size:16px; }
.pkg100-cur{ font-style:normal; font-size:9.5px; font-weight:800; letter-spacing:.12em; padding:3px 8px;
  border-radius:999px; color:#04101f; background:linear-gradient(135deg,#7fd7ff,#4f9dff); }
.pkg100-row > .pkg100-bd > i{ display:block; font-style:normal; font-size:12px; color:rgba(170,200,255,.78); margin-top:2px; }
.pkg100-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.pkg100-chips span{ display:inline-flex; align-items:center; gap:6px; font-size:11.5px; padding:5px 10px;
  border-radius:999px; background:rgba(70,130,220,.16); border:1px solid rgba(110,170,255,.25); color:#cfe4ff; }
.pkg100-row.on .pkg100-chips span{ background:rgba(90,180,255,.24); }
.pkg100-dot{ width:8px; height:8px; border-radius:50%; box-shadow:0 0 8px currentColor; }

/* ===== v101: grid reload per level ===== */
.sync101{ flex-basis:100%; width:100%; grid-column:1/-1; display:flex; align-items:baseline; gap:10px; margin:4px 2px 2px; }
.sync101 b{ font-size:16px; color:#eaf2ff; text-shadow:0 0 14px rgba(90,170,255,.35); }
.sync101 span{ font-size:12.5px; color:rgba(170,200,255,.75); }
@keyframes syncIn{ from{ opacity:0; transform:translateY(14px) scale(.96); } to{ opacity:1; transform:none; } }
@media (prefers-reduced-motion:reduce){ @keyframes syncIn{ from,to{ opacity:1; transform:none; } } }

/* ===== v102: alfred logo discs, sorted responsive grid ===== */
.pkg100-mg{ position:relative; overflow:hidden;
  background:radial-gradient(circle at 30% 25%, rgba(70,110,180,.22), rgba(8,12,24,.92)) !important; }
.pkg100-row[data-k="Free"] .pkg100-mg, .pkg100-row[data-k="Pro"] .pkg100-mg, .pkg100-row[data-k="Ultra"] .pkg100-mg{
  background:radial-gradient(circle at 30% 25%, rgba(70,110,180,.22), rgba(8,12,24,.92)) !important; }
.pkg100-mg img, .pkg100-mg svg{ width:62% !important; height:62% !important; object-fit:contain; border-radius:0; }
.pkg100-row[data-k="Free"] .pkg100-mg{ border-color:rgba(150,170,200,.3); box-shadow:inset 0 0 12px rgba(0,0,0,.55); }
.pkg100-row[data-k="Free"] .pkg100-mg img, .pkg100-row[data-k="Free"] .pkg100-mg svg{ filter:grayscale(.45) brightness(.82); opacity:.85; }
.pkg100-row[data-k="Pro"] .pkg100-mg{ border-color:rgba(120,210,255,.7);
  box-shadow:0 0 18px rgba(80,170,255,.5), inset 0 0 12px rgba(0,20,50,.5); }
.pkg100-row[data-k="Pro"] .pkg100-mg img, .pkg100-row[data-k="Pro"] .pkg100-mg svg{ filter:brightness(1.08) drop-shadow(0 0 6px rgba(120,210,255,.8)); }
.pkg100-row[data-k="Ultra"] .pkg100-mg{ border-color:rgba(255,205,120,.8);
  box-shadow:0 0 26px rgba(255,180,90,.55), inset 0 0 14px rgba(40,20,0,.5); }
.pkg100-row[data-k="Ultra"] .pkg100-mg img, .pkg100-row[data-k="Ultra"] .pkg100-mg svg{ filter:brightness(1.2) saturate(1.2) drop-shadow(0 0 8px rgba(255,200,120,.9)); }
.pkg100-row[data-k="Ultra"] .pkg100-mg::after{ content:""; position:absolute; inset:-3px; border-radius:50%;
  background:conic-gradient(from 0deg, rgba(255,200,120,0), rgba(255,200,120,.6), rgba(255,200,120,0) 42%);
  animation:u102spin 3.4s linear infinite; pointer-events:none; }
@keyframes u102spin{ to{ transform:rotate(360deg); } }
.m102-grid{ display:grid !important; grid-template-columns:repeat(auto-fill, minmax(clamp(140px,42vw,220px),1fr)) !important;
  gap:clamp(10px,2.6vw,16px) !important; grid-auto-rows:1fr; align-items:stretch; }
.m102-grid > *{ min-width:0; }
@media (prefers-reduced-motion:reduce){ .pkg100-row[data-k="Ultra"] .pkg100-mg::after{ animation:none; opacity:.5; } }
@media (min-width:1100px){ .pkg100{ max-width:820px; margin-left:auto; margin-right:auto; width:100%; } }

/* ===== v103: solo levels page ===== */
#view-modules .pkg100{ position:relative; z-index:2; max-width:720px;
  width:calc(100% - 28px); margin:22px auto 52px; }
#view-modules .pkg100-t{ font-size:clamp(13px,3.4vw,15px); text-align:center; margin-bottom:16px; }
.pkg100-mg img{ width:64% !important; height:64% !important; object-fit:contain; border-radius:50%; }
@media (max-width:360px){ .pkg100-row{ padding:12px 12px; gap:10px; } .pkg100-mg{ width:38px; height:38px; flex-basis:38px; } }
@media (min-width:1100px){ #view-modules .pkg100{ max-width:780px; } }

/* ===== v104: level energies — same Alfred, different fire ===== */
.pkg100-mg img, .pkg100-mg svg:not(.alfmark104){ display:none !important; }   /* any wrong icon is evicted */
.alfmark104{ width:60% !important; height:60% !important; display:block; margin:auto; }
@keyframes alfPulse{ 0%,100%{ opacity:.78; } 50%{ opacity:1; } }

.pkg100-row[data-k="Free"] .pkg100-mg{
  background:radial-gradient(circle at 32% 26%, rgba(120,140,175,.28), rgba(8,12,24,.95)) !important;
  border-color:rgba(150,170,200,.3) !important; box-shadow:inset 0 0 14px rgba(0,0,0,.6); }
.pkg100-row[data-k="Free"] .alfmark104{ filter:grayscale(.4) brightness(.85);
  animation:alfPulse 4.6s ease-in-out infinite; }                       /* ember: slow calm breath */

.pkg100-row[data-k="Pro"] .pkg100-mg{
  background:radial-gradient(circle at 32% 26%, rgba(60,140,230,.34), rgba(6,14,30,.95)) !important;
  border-color:rgba(120,210,255,.75) !important;
  box-shadow:0 0 18px rgba(80,170,255,.5), inset 0 0 12px rgba(0,20,50,.5); }
.pkg100-row[data-k="Pro"] .alfmark104{ filter:brightness(1.12) drop-shadow(0 0 7px rgba(120,210,255,.95));
  animation:alfPulse 2.5s ease-in-out infinite; }                       /* electric: bright cyan pulse */

.pkg100-row[data-k="Ultra"] .pkg100-mg{
  background:radial-gradient(circle at 32% 26%, rgba(255,170,80,.32), rgba(20,12,4,.95)) !important;
  border-color:rgba(255,205,120,.85) !important;
  box-shadow:0 0 26px rgba(255,180,90,.55), inset 0 0 14px rgba(40,20,0,.5); }
.pkg100-row[data-k="Ultra"] .alfmark104{ filter:brightness(1.25) saturate(1.3) drop-shadow(0 0 10px rgba(255,200,120,1));
  animation:alfPulse 1.7s ease-in-out infinite; }                       /* supernova: gold, fast, alive */
.pkg100-row[data-k="Ultra"] .pkg100-mg::after{ content:""; position:absolute; inset:-3px; border-radius:50%;
  background:conic-gradient(from 0deg, rgba(255,200,120,0), rgba(255,200,120,.6), rgba(255,200,120,0) 42%);
  animation:u102spin 3.4s linear infinite; pointer-events:none; }
@keyframes u102spin{ to{ transform:rotate(360deg); } }

@media (prefers-reduced-motion:reduce){
  .alfmark104{ animation:none !important; }
  .pkg100-row[data-k="Ultra"] .pkg100-mg::after{ animation:none; opacity:.5; }
}
@media (max-width:360px){ .pkg100-mg{ width:40px; height:40px; flex-basis:40px; } }
@media (min-width:1100px){ #view-modules .pkg100{ max-width:780px; } }

/* ===== v104: level energies — same Alfred, different fire ===== */
.pkg100-mg img, .pkg100-mg svg:not(.alfmark104){ display:none !important; }   /* any wrong icon is evicted */
.alfmark104{ width:60% !important; height:60% !important; display:block; margin:auto; }
@keyframes alfPulse{ 0%,100%{ opacity:.78; } 50%{ opacity:1; } }

.pkg100-row[data-k="Free"] .pkg100-mg{
  background:radial-gradient(circle at 32% 26%, rgba(120,140,175,.28), rgba(8,12,24,.95)) !important;
  border-color:rgba(150,170,200,.3) !important; box-shadow:inset 0 0 14px rgba(0,0,0,.6); }
.pkg100-row[data-k="Free"] .alfmark104{ filter:grayscale(.4) brightness(.85);
  animation:alfPulse 4.6s ease-in-out infinite; }                       /* ember: slow calm breath */

.pkg100-row[data-k="Pro"] .pkg100-mg{
  background:radial-gradient(circle at 32% 26%, rgba(60,140,230,.34), rgba(6,14,30,.95)) !important;
  border-color:rgba(120,210,255,.75) !important;
  box-shadow:0 0 18px rgba(80,170,255,.5), inset 0 0 12px rgba(0,20,50,.5); }
.pkg100-row[data-k="Pro"] .alfmark104{ filter:brightness(1.12) drop-shadow(0 0 7px rgba(120,210,255,.95));
  animation:alfPulse 2.5s ease-in-out infinite; }                       /* electric: bright cyan pulse */

.pkg100-row[data-k="Ultra"] .pkg100-mg{
  background:radial-gradient(circle at 32% 26%, rgba(255,170,80,.32), rgba(20,12,4,.95)) !important;
  border-color:rgba(255,205,120,.85) !important;
  box-shadow:0 0 26px rgba(255,180,90,.55), inset 0 0 14px rgba(40,20,0,.5); }
.pkg100-row[data-k="Ultra"] .alfmark104{ filter:brightness(1.25) saturate(1.3) drop-shadow(0 0 10px rgba(255,200,120,1));
  animation:alfPulse 1.7s ease-in-out infinite; }                       /* supernova: gold, fast, alive */
.pkg100-row[data-k="Ultra"] .pkg100-mg::after{ content:""; position:absolute; inset:-3px; border-radius:50%;
  background:conic-gradient(from 0deg, rgba(255,200,120,0), rgba(255,200,120,.6), rgba(255,200,120,0) 42%);
  animation:u102spin 3.4s linear infinite; pointer-events:none; }
@keyframes u102spin{ to{ transform:rotate(360deg); } }

@media (prefers-reduced-motion:reduce){
  .alfmark104{ animation:none !important; }
  .pkg100-row[data-k="Ultra"] .pkg100-mg::after{ animation:none; opacity:.5; }
}
@media (max-width:360px){ .pkg100-mg{ width:40px; height:40px; flex-basis:40px; } }
@media (min-width:1100px){ #view-modules .pkg100{ max-width:780px; } }

/* ===== v105: level identity — topbar + mark polish ===== */
.lvl105-t{ font-weight:800; letter-spacing:.02em; background-clip:text; -webkit-background-clip:text; color:transparent; }
.lvl105-t-Free{ background-image:linear-gradient(135deg,#dfe9f8,#8fa2c0); }
.lvl105-t-Pro{ background-image:linear-gradient(135deg,#8fe0ff,#2f7cff); }
.lvl105-t-Ultra{ background-image:linear-gradient(135deg,#ffe9b0,#ff9d3c); }
.tb105{ position:relative; transition:box-shadow .5s; }
.tb105-Free{ box-shadow:0 0 10px rgba(160,180,215,.4), inset 0 0 8px rgba(0,0,0,.5); animation:alfPulse 4.6s ease-in-out infinite; }
.tb105-Pro{ box-shadow:0 0 18px rgba(90,180,255,.7), inset 0 0 8px rgba(0,25,60,.5); animation:alfPulse 2.5s ease-in-out infinite; }
.tb105-Ultra{ box-shadow:0 0 26px rgba(255,185,95,.8), inset 0 0 10px rgba(45,25,0,.5); animation:alfPulse 1.7s ease-in-out infinite; }
.tb105-Ultra::after{ content:""; position:absolute; inset:-3px; border-radius:50%;
  background:conic-gradient(from 0deg,rgba(255,200,120,0),rgba(255,200,120,.55),rgba(255,200,120,0) 42%);
  animation:u102spin 3.4s linear infinite; pointer-events:none; }
.pkg100-mg::before{ content:""; position:absolute; inset:10%; border-radius:50%; pointer-events:none; }
.pkg100-row[data-k="Free"]  .pkg100-mg::before{ background:radial-gradient(circle,rgba(180,200,230,.20),transparent 70%); }
.pkg100-row[data-k="Pro"]   .pkg100-mg::before{ background:radial-gradient(circle,rgba(110,200,255,.30),transparent 70%); }
.pkg100-row[data-k="Ultra"] .pkg100-mg::before{ background:radial-gradient(circle,rgba(255,200,120,.32),transparent 70%); }
.pkg100-row[data-k="Pro"]   .alfmark104{ filter:brightness(1.12) drop-shadow(0 0 8px rgba(110,200,255,.95)); }
.pkg100-row[data-k="Ultra"] .alfmark104{ filter:brightness(1.2) saturate(1.25) drop-shadow(0 0 10px rgba(255,200,120,1)); }
@media (prefers-reduced-motion:reduce){ .tb105,.tb105-Ultra::after{ animation:none !important; opacity:.6; } }

/* ===== v106: mark life ===== */
.alv-orb{ transform-box:fill-box; transform-origin:center; animation:u102spin 7s linear infinite; }
.pkg100-row[data-k="Ultra"] .alv-orb{ animation-duration:4.5s; }
.tb105 svg{ width:62% !important; height:62% !important; display:block; margin:auto; }
@media (prefers-reduced-motion:reduce){ .alv-orb{ animation:none !important; } }

/* ===== v107: mark breathing ===== */
.tb105 svg{ width:64% !important; height:64% !important; display:block; margin:auto; }
.pkg100-mg .alfmark104{ width:68% !important; height:68% !important; }

/* ===== v108: level fire in chat ===== */
.cl108{ transition:box-shadow .5s; }
.cl108-Free{ box-shadow:0 0 0 1.5px rgba(165,190,225,.35), 0 0 16px rgba(160,185,220,.22) !important; }
.cl108-Pro{ box-shadow:0 0 0 1.5px rgba(110,200,255,.6), 0 0 20px rgba(80,170,255,.45) !important; }
.cl108-Ultra{ box-shadow:0 0 0 1.5px rgba(255,200,120,.65), 0 0 22px rgba(255,180,90,.5) !important; }
.tbimg108-Free{ filter:grayscale(.2) brightness(.95) drop-shadow(0 0 6px rgba(165,190,225,.6)); }
.tbimg108-Pro{ filter:brightness(1.15) saturate(1.2) drop-shadow(0 0 8px rgba(110,200,255,.95)); }
.tbimg108-Ultra{ filter:brightness(1.2) saturate(1.35) drop-shadow(0 0 10px rgba(255,195,110,1)); }
.hero108{ transition:filter .6s; }
.hero108-Free{ filter:drop-shadow(0 0 24px rgba(150,175,215,.35)); }
.hero108-Pro{ filter:drop-shadow(0 0 36px rgba(90,180,255,.7)) saturate(1.15) brightness(1.08); }
.hero108-Ultra{ filter:drop-shadow(0 0 40px rgba(255,185,95,.75)) saturate(1.3) brightness(1.12); }

/* ===== v109: one light everywhere ===== */
.lvldisc{ transition:box-shadow .5s; }
.lvldisc-Free{ box-shadow:0 0 0 1.5px rgba(165,190,225,.4), 0 0 16px rgba(160,185,220,.25) !important; }
.lvldisc-Pro{ box-shadow:0 0 0 1.5px rgba(110,200,255,.65), 0 0 22px rgba(80,170,255,.5) !important; }
.lvldisc-Ultra{ box-shadow:0 0 0 1.5px rgba(255,200,120,.7), 0 0 26px rgba(255,180,90,.55) !important; }
.lvldisc svg, .lvldisc img{ transition:filter .5s; }
.lvldisc-Free svg, .lvldisc-Free img{ filter:grayscale(.15) brightness(.98) drop-shadow(0 0 6px rgba(165,190,225,.65)); }
.lvldisc-Pro svg, .lvldisc-Pro img{ filter:brightness(1.15) saturate(1.25) drop-shadow(0 0 9px rgba(110,200,255,.95)); }
.lvldisc-Ultra svg, .lvldisc-Ultra img{ filter:brightness(1.2) saturate(1.4) drop-shadow(0 0 11px rgba(255,195,110,1)); }

/* ===== v110: hero level fire ===== */
.hero110w{ position:relative; display:inline-block; line-height:0; }
.hero110w::before{ content:""; position:absolute; inset:-20%; border-radius:50%; z-index:0; pointer-events:none; }
.hero110-Free::before{ background:radial-gradient(circle, rgba(160,185,220,.16), transparent 65%); }
.hero110-Pro::before{ background:radial-gradient(circle, rgba(90,180,255,.28), transparent 65%); }
.hero110-Ultra::before{ background:radial-gradient(circle, rgba(255,180,90,.30), transparent 65%); }
.hero110w img, .hero110w svg{ position:relative; z-index:1; transition:filter .6s; }
.hero110-Free img, .hero110-Free svg{ filter:drop-shadow(0 0 26px rgba(150,175,215,.45)) !important; }
.hero110-Pro img, .hero110-Pro svg{ filter:drop-shadow(0 0 40px rgba(90,180,255,.8)) saturate(1.2) brightness(1.08) !important; }
.hero110-Ultra img, .hero110-Ultra svg{ filter:drop-shadow(0 0 46px rgba(255,185,95,.9)) saturate(1.3) brightness(1.12) !important; }
.hero110-ov{ position:absolute; inset:-16%; width:132%; height:132%; z-index:2;
  pointer-events:none; overflow:visible; animation:alfPulse 4.8s ease-in-out infinite; }
.hero110-Pro .hero110-ov{ animation-duration:2.6s; }
.hero110-Ultra .hero110-ov{ animation-duration:1.7s; }
@media (prefers-reduced-motion:reduce){ .hero110-ov{ animation:none !important; } }

/* ===== v111: chat avatar = full mark; hero stays original ===== */
.msg-av .alfmark104{ width:78% !important; height:78% !important; }
.hero110-ov{ display:none !important; }
.hero110w::before{ display:none !important; }
.hero108-Free, .hero108-Pro, .hero108-Ultra{ filter:none !important; }

/* ===== v112: full marks in topbar + new chat ===== */
.lvldisc > svg, .lvldisc svg.alfmark104{ width:72%; height:72%; display:block; margin:auto; }
.lvldisc img{ width:72%; height:72%; object-fit:contain; border-radius:50%; }

/* ===== v113: VIP welcome ===== */
.v113h{ display:inline; }
.vip{ animation:vipIn .65s cubic-bezier(.2,.8,.2,1) both; }
@keyframes vipIn{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }
.vip-badge{ display:inline-flex; align-items:center; gap:6px; font-size:10.5px; font-weight:800;
  letter-spacing:.14em; padding:5px 12px; border-radius:999px; margin-bottom:10px; }
.vip-Pro .vip-badge{ color:#04101f; background:linear-gradient(135deg,#8fe0ff,#2f7cff);
  box-shadow:0 0 18px rgba(80,170,255,.5); }
.vip-Ultra .vip-badge{ color:#1a1005; background:linear-gradient(135deg,#ffe9b0,#ff9d3c);
  box-shadow:0 0 20px rgba(255,180,90,.55); }
.vip p{ font-size:15.5px; line-height:1.62; margin:2px 0 0; }
.vipw-Pro{ background:linear-gradient(135deg,#8fe0ff,#2f7cff); -webkit-background-clip:text; background-clip:text; color:transparent; }
.vipw-Ultra{ background:linear-gradient(135deg,#ffe9b0,#ff9d3c); -webkit-background-clip:text; background-clip:text; color:transparent; }
.bubble.vip-Pro{ border-color:rgba(110,200,255,.55) !important;
  box-shadow:0 0 26px rgba(80,170,255,.28), inset 0 0 24px rgba(60,140,255,.10) !important; }
.bubble.vip-Ultra{ border-color:rgba(255,205,120,.6) !important;
  box-shadow:0 0 30px rgba(255,180,90,.30), inset 0 0 26px rgba(255,160,60,.10) !important; }

/* ===== v114: history grid, safe preview, compact module levels ===== */
#view-history .hgrid114 {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)) !important;
  grid-auto-rows: minmax(82px, auto) !important;
  align-content: start !important;
  align-items: stretch !important;
  justify-content: stretch !important;
  gap: 12px !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 12px 14px !important;
  box-sizing: border-box !important;
}
#view-history.hhaspreview114 .hgrid114 {
  padding-bottom: calc(320px + env(safe-area-inset-bottom, 0px)) !important;
}
#view-history .hgrid114 > .hcard114 {
  width: auto !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 82px !important;
  height: auto !important;
  align-self: stretch !important;
  box-sizing: border-box !important;
  padding: 10px 12px !important;
}
#view-history .hpreview114 {
  position: fixed !important;
  left: 50% !important;
  right: auto !important;
  top: auto !important;
  bottom: calc(72px + env(safe-area-inset-bottom, 0px)) !important;
  transform: translateX(-50%) !important;
  width: min(420px, calc(100vw - 24px)) !important;
  max-width: calc(100vw - 24px) !important;
  max-height: min(34vh, 300px) !important;
  overflow: auto !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  z-index: 10020 !important;
}
#view-history .hspin114 {
  position: fixed !important;
  left: 50% !important;
  right: auto !important;
  top: auto !important;
  bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important;
  transform: translateX(-50%) !important;
  z-index: 10021 !important;
}

/* Compact package rows — content and level logic untouched */
#view-modules .pkg100 {
  width: min(900px, calc(100% - 24px)) !important;
  max-width: 900px !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  flex: 0 0 auto !important;
  align-self: center !important;
  align-content: start !important;
  grid-template-rows: none !important;
  grid-auto-rows: max-content !important;
  margin: clamp(10px, 2vh, 22px) auto !important;
  box-sizing: border-box !important;
}
#view-modules .pkg100-row {
  flex: 0 0 auto !important;
  flex-grow: 0 !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  grid-row: auto !important;
  align-self: stretch !important;
  padding: 11px 13px !important;
  box-sizing: border-box !important;
}
#view-modules .pkg100-mg {
  width: 38px !important;
  height: 38px !important;
  flex: 0 0 38px !important;
}
#view-modules .pkg100-row [class*="chips"],
#view-modules .pkg100-row [class*="models"] {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 6px !important;
}
#view-modules .pkg100-row [class*="chip"] {
  flex: 0 0 auto !important;
  min-height: 0 !important;
  white-space: nowrap;
}
@media (max-width: 480px) {
  #view-history .hgrid114 { gap: 9px !important; padding-inline: 10px !important; }
  #view-history .hgrid114 > .hcard114 { min-height: 74px !important; }
  #view-modules .pkg100 { width: calc(100% - 18px) !important; }
  #view-modules .pkg100-row { padding: 9px 10px !important; }
}

/* ===== v115: keyboard lift (no layout change) ===== */
#view-chat .composer.alfred-kbd-lift {
  translate: 0 calc(0px - var(--alfred-kbd-overlap, 0px)) !important;
}

/* ===== v115: undo toast ===== */
.v115-undo {
  position: fixed; left: 50%;
  bottom: calc(18px + env(safe-area-inset-bottom, 0px));
  transform: translateX(-50%); z-index: 2147483647;
  display: flex; align-items: center; gap: 18px;
  width: max-content; max-width: calc(100vw - 28px);
  padding: 12px 16px; border-radius: 16px; color: #eaf5ff;
  border: 1px solid rgba(110,190,255,.42);
  background: rgba(5,15,35,.96);
  box-shadow: 0 8px 30px rgba(0,0,0,.42), 0 0 22px rgba(50,150,255,.18);
  box-sizing: border-box;
}
.v115-undo button {
  border: 0; padding: 7px 10px; border-radius: 10px;
  color: #a9dcff; background: rgba(55,135,220,.18);
  font: inherit; font-weight: 700; cursor: pointer;
}
@media (max-width: 420px) { .v115-undo { gap: 12px; padding: 10px 13px; font-size: 14px; } }

/* ===== v116: auth messages ===== */
.v116-err {
  display: none; margin: 10px auto 0; max-width: 420px;
  padding: 10px 14px; border-radius: 12px; font-size: 14px;
  color: #ffd9d9; background: rgba(180, 40, 60, .16);
  border: 1px solid rgba(255, 110, 130, .35);
}
.v116-toast {
  position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  transform: translateX(-50%); z-index: 2147483647;
  padding: 10px 18px; border-radius: 999px; color: #dff1ff;
  background: rgba(8, 18, 40, .95); border: 1px solid rgba(110, 190, 255, .4);
  box-shadow: 0 8px 26px rgba(0, 0, 0, .4);
}

/* ===== v118: auth messages ===== */
.v118-err { display:none; margin:10px auto 0; max-width:420px; padding:10px 14px; border-radius:12px; font-size:14px; color:#ffd9d9; background:rgba(180,40,60,.16); border:1px solid rgba(255,110,130,.35); }
.v118-toast { position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%); z-index:2147483647; padding:10px 18px; border-radius:999px; color:#dff1ff; background:rgba(8,18,40,.95); border:1px solid rgba(110,190,255,.4); box-shadow:0 8px 26px rgba(0,0,0,.4); }

/* ===== v119: auth messages ===== */
.v119-err { display:none; margin:10px auto 0; max-width:420px; padding:10px 14px; border-radius:12px; font-size:14px; color:#ffd9d9; background:rgba(180,40,60,.16); border:1px solid rgba(255,110,130,.35); }
.v119-toast { position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%); z-index:2147483647; padding:10px 18px; border-radius:999px; color:#dff1ff; background:rgba(8,18,40,.95); border:1px solid rgba(110,190,255,.4); box-shadow:0 8px 26px rgba(0,0,0,.4); }

/* ===== v120: auth messages ===== */
.v120-err { display:none; margin:10px auto 0; max-width:420px; padding:10px 14px; border-radius:12px; font-size:14px; color:#ffd9d9; background:rgba(180,40,60,.16); border:1px solid rgba(255,110,130,.35); }
.v120-toast { position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%); z-index:2147483647; padding:10px 18px; border-radius:999px; color:#dff1ff; background:rgba(8,18,40,.95); border:1px solid rgba(110,190,255,.4); box-shadow:0 8px 26px rgba(0,0,0,.4); }

/* ===== v122: Settings sign-out ===== */
.v122-signout {
  width: min(560px, calc(100% - 32px));
  margin: 16px auto;
  padding: 16px;
  color: #e7f2ff;
  background: rgba(10,18,38,.85);
  border: 1px solid rgba(110,190,255,.28);
  border-radius: 16px;
  box-sizing: border-box;
}
.v122-so-h {
  margin-bottom: 10px;
  color: #8edcff;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.v122-so-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 44px;
  padding: 12px 16px;
  color: #ffd7d7;
  background: rgba(220,70,80,.14);
  border: 1px solid rgba(255,110,120,.35);
  border-radius: 12px;
  font: inherit;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}
.v122-so-btn:hover, .v122-so-btn:active { filter: brightness(1.2); }

.v122-sheet {
  position: fixed;
  inset: 0;
  z-index: 2147483647;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 16px calc(20px + env(safe-area-inset-bottom,0px));
  background: rgba(0,0,0,.6);
  box-sizing: border-box;
}
.v122-sheet-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: min(340px, 100%);
  padding: 22px;
  color: #eaf4ff;
  background: #09152b;
  border: 1px solid rgba(110,190,255,.3);
  border-radius: 18px;
  box-shadow: 0 18px 60px rgba(0,0,0,.5);
  box-sizing: border-box;
}
.v122-sheet-card h2 { margin: 0; font-size: 19px; }
.v122-sheet-card p { margin: 0 0 8px; color: #a9bbd3; font-size: 14px; }
.v122-sheet-cancel, .v122-sheet-go {
  width: 100%;
  min-height: 44px;
  padding: 10px 14px;
  border-radius: 12px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}
.v122-sheet-cancel {
  color: #dceaff;
  background: transparent;
  border: 1px solid rgba(130,170,220,.3);
}
.v122-sheet-go {
  color: #ffd7d7;
  background: rgba(220,70,80,.18);
  border: 1px solid rgba(255,110,120,.42);
}
.v122-sheet-cancel:hover, .v122-sheet-go:hover { filter: brightness(1.18); }
.v122-sheet-go:disabled { opacity: .65; cursor: wait; }
.v122-toast {
  position: fixed;
  left: 50%;
  bottom: calc(24px + env(safe-area-inset-bottom,0px));
  z-index: 2147483647;
  transform: translateX(-50%);
  max-width: calc(100vw - 28px);
  padding: 11px 16px;
  color: #ffe4e4;
  background: rgba(48,12,24,.97);
  border: 1px solid rgba(255,110,120,.42);
  border-radius: 14px;
  box-shadow: 0 8px 26px rgba(0,0,0,.4);
  font-size: 14px;
}

/* ===== v123: auth messages ===== */
.v123-err { display:none; margin:10px auto 0; max-width:420px; padding:10px 14px; border-radius:12px; font-size:14px; color:#ffd9d9; background:rgba(180,40,60,.16); border:1px solid rgba(255,110,130,.35); }
.v123-toast { position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%); z-index:2147483647; padding:10px 18px; border-radius:999px; color:#dff1ff; background:rgba(8,18,40,.95); border:1px solid rgba(110,190,255,.4); box-shadow:0 8px 26px rgba(0,0,0,.4); }

/* ===== v124: legal sheets ===== */
.v124-sheet{position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;
  background:rgba(4,10,26,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:18px;}
.v124-card{position:relative;width:min(94vw,640px);max-height:86vh;display:flex;flex-direction:column;
  background:linear-gradient(160deg,rgba(12,24,48,.96),rgba(8,16,36,.96));
  border:1px solid rgba(110,190,255,.35);border-radius:20px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden;}
.v124-x{position:absolute;top:10px;right:10px;z-index:2;width:34px;height:34px;border-radius:50%;
  border:1px solid rgba(140,200,255,.35);background:rgba(10,22,44,.8);color:#bfe0ff;font-size:15px;cursor:pointer;}
.v124-brand{display:flex;align-items:center;gap:10px;padding:16px 46px 12px 20px;font-weight:700;font-size:17px;color:#e8f4ff;letter-spacing:.4px;}
.v124-mark{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;
  background:radial-gradient(circle at 30% 25%,rgba(120,200,255,.5),rgba(40,110,220,.35));color:#eaf6ff;
  font-size:15px;font-weight:800;border:1px solid rgba(140,200,255,.45);}
.v124-body{overflow:auto;-webkit-overflow-scrolling:touch;padding:4px 20px 22px;color:#c8d9ee;font-size:14px;line-height:1.65;}
.v124-body h3{margin:16px 0 6px;font-size:14.5px;color:#9fd0ff;letter-spacing:.3px;}
.v124-body p{margin:0 0 10px;}
.v124-f{margin-top:14px;padding-top:10px;border-top:1px solid rgba(120,180,255,.18);font-size:12.5px;color:#8ea9c8;}
@media (max-width:480px){ .v124-card{max-height:88vh;border-radius:18px;} .v124-body{font-size:13.5px;} }

/* ===== v126: hardening UI ===== */
.v126-hp{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important;}
.v126-meter{display:flex;gap:4px;align-items:center;margin:7px 0 2px;}
.v126-meter span{height:4px;flex:1;border-radius:4px;background:rgba(120,160,220,.16);transition:background .25s;}
.v126-meter.s1 span:nth-child(1){background:#e05c5c;}
.v126-meter.s2 span:nth-child(-n+2){background:#e8b64c;}
.v126-meter.s3 span{background:#3ddc84;}
.v126-mlbl{font-size:11.5px;color:#9db8d8;margin-left:6px;font-style:normal;min-width:56px;}

/* ===== v128: recovery + security center ===== */
.v128-card{max-width:480px;}
.v128-h{font-weight:700;font-size:17px;color:#e8f4ff;margin:4px 46px 10px 20px;}
.v128-h.danger{color:#ff9d9d;}
.v128-h2{font-weight:700;font-size:14px;color:#9fd0ff;letter-spacing:.4px;margin:0 0 8px;}
.v128-p{font-size:13.5px;color:#b9cde6;line-height:1.55;margin:0 20px 12px;}
.v128-in{width:calc(100% - 40px);margin:0 20px 10px;padding:12px 14px;border-radius:12px;font-size:14px;
  color:#eaf3ff;background:rgba(8,18,38,.8);border:1px solid rgba(120,180,255,.35);box-sizing:border-box;}
.v128-btn{display:block;width:calc(100% - 40px);margin:6px 20px 4px;padding:12px;border:0;border-radius:999px;
  font-weight:700;font-size:14.5px;color:#fff;cursor:pointer;
  background:linear-gradient(90deg,#1f8fe0,#31b3e8);}
.v128-btn.red{background:linear-gradient(90deg,#c0392b,#e05c5c);}
.v128-btn:disabled{opacity:.45;cursor:not-allowed;}
.v128-msg{margin:8px 20px 12px;font-size:13px;color:#b9cde6;min-height:16px;}
.v128-msg.ok{color:#7fe0a8;} .v128-msg.bad{color:#ff9d9d;}
.v128-sec{margin:14px 0 10px;padding:14px;border:1px solid rgba(110,190,255,.28);border-radius:16px;
  background:rgba(10,22,44,.55);}
.v128-row{display:block;width:100%;text-align:left;margin:6px 0;padding:11px 13px;border-radius:11px;font-size:14px;
  color:#dfeaf8;background:rgba(20,40,76,.5);border:1px solid rgba(120,180,255,.2);cursor:pointer;}
.v128-row.danger{color:#ffb3b3;border-color:rgba(255,110,130,.3);}
.v128-toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);z-index:2147483647;
  padding:10px 18px;border-radius:999px;font-size:13.5px;color:#dff1ff;background:rgba(8,18,40,.95);
  border:1px solid rgba(110,190,255,.4);box-shadow:0 8px 26px rgba(0,0,0,.4);}
.v128-toast.bad{border-color:rgba(255,110,130,.5);color:#ffd9d9;}

/* ===== v128: recovery + security center ===== */
.v128-card{max-width:480px;}
.v128-h{font-weight:700;font-size:17px;color:#e8f4ff;margin:4px 46px 10px 20px;}
