      if (!all[i].children.length && /continue with|sign up with/i.test(all[i].textContent || "")) { mark = all[i]; break; }
    }
    if (!mark) return null;
    var slots = slotsAfter(card, mark);
    var host = el.closest("button,a,[role=button]") || el;
    var ix = slots.indexOf(host);
