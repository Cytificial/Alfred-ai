      if ((bi.indexOf("brand-") > -1 || bi.indexOf("lambda-") > -1 || bi.indexOf("logo") > -1) && e.offsetHeight >= 140) {
        e.style.backgroundImage = "none"; e.setAttribute("data-v254bg", "1");
      }
