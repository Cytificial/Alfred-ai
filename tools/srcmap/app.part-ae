    if (s && t && s.offsetParent !== null) { li = (li + 1) % LINES.length; t.textContent = LINES[li]; }
  }, 780);
  /* --- landing: product moment + fig renumber + living changelog + honest footer --- */
  var st2 = document.createElement("style");
  st2.textContent = [
